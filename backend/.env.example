# Copy to .env and fill in. Never commit .env
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/readaloud
SECRET_KEY=change-me-to-a-long-random-string
# Shared code that lets friends create an account (they get DEFAULT_APPS)
INVITE_CODE=choose-a-private-code
# Your email(s), comma separated. These accounts are always admins.
ADMIN_EMAILS=you@example.com
# Apps given to people who join with INVITE_CODE: library, transcribe
DEFAULT_APPS=library
# Transcription engine: a free key from https://console.groq.com
GROQ_API_KEY=
TRANSCRIBE_ENGINE=groq
# Voice Q&A ("Ask the Book/Sermon") uses the same Groq key with this chat model
GROQ_CHAT_MODEL=openai/gpt-oss-120b
MAX_AUDIO_MB=4096
STORAGE_DIR=./storage
# Where PDFs are kept. "local" = this computer's disk. "s3" = a permanent online bucket
# (Cloudflare R2, Backblaze B2, Supabase Storage...). Needed on a free host, which forgets files.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
