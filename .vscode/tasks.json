{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: run (port 8000)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/python -m uvicorn app.main:app --port 8000",
      "windows": { "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
